{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix src/frontend ci",
  "buildCommand": "npm --prefix src/frontend run build",
  "outputDirectory": "src/frontend/dist",
  "crons": [
    { "path": "/api/internal/keepalive", "schedule": "0 3 * * *" }
  ],
  "functions": {
    "api/[...path].py": {
      "maxDuration": 60
    },
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy-Report-Only", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' blob: https://*.supabase.co; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https://*.supabase.co; media-src 'self' blob: https://*.supabase.co; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)\\.map$",
      "status": 403
    },
    {
      "src": "/(docs|docs/.*|redoc|redoc/.*|openapi.json)",
      "status": 404
    },
    {
      "src": "/(health/live|health/ready|openapi.json|docs|docs/.*|robots.txt)",
      "dest": "/api/[...path].py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

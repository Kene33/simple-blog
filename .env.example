APP_NAME=Simple Blog API
APP_VERSION=0.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=4000
RELOAD=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:4000,http://127.0.0.1:5500
DATABASE_URL=postgresql+asyncpg://blog:blog@localhost:5432/blog
JWT_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=simple-blog-media
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-before-running-seed

APP_NAME=Simple Blog API
APP_VERSION=0.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=4000
RELOAD=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:4000,http://127.0.0.1:5500
DATABASE_URL=postgresql+asyncpg://blog:blog@localhost:5432/blog
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=
PUBLIC_BASE_URL=http://localhost:4000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
REDIS_URL=
CRON_SECRET=replace-with-a-random-secret
MEDIA_QUOTA_BYTES=1073741824
MEDIA_QUOTA_FILES=100
MEDIA_PENDING_LIMIT=10
MEDIA_PUBLIC_CACHE_SECONDS=300
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=simple-blog-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-password
S3_REGION=us-east-1
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-before-running-seed
